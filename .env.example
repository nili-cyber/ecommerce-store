# Copy this to .env on the EC2 instance and fill in real values.
# Never commit the real .env file.

DB_PASSWORD=change_this_to_a_strong_password
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
# The public URL you'll access the site at, e.g. http://<your-ec2-public-ip>
# or https://yourdomain.com once you've set up a domain + TLS.
PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP

# From https://dashboard.stripe.com/test/apikeys (use test keys until you're
# ready to go live) and https://dashboard.stripe.com/test/webhooks
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# From https://developer.paypal.com/dashboard/applications (create a
# Sandbox app for testing)
PAYPAL_CLIENT_ID=REPLACE_ME_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_ME_PAYPAL_CLIENT_SECRET
